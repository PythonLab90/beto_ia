# Groq API Configuration
GROQ_API_KEY=tu_clave_de_groq
GROQ_MODEL=openai/gpt-oss-20b
PORT=3000

# Email reminders. Keep real credentials in .env or your hosting provider's secrets.
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Use the sender account's address and its app password, not the regular password.
EMAIL_HOST_USER=tu_cuenta@gmail.com
EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion
DEFAULT_FROM_EMAIL=Beto UNEMI <tu_cuenta@gmail.com>
# Render Free blocks SMTP ports; use Brevo's HTTPS API there.
BREVO_API_KEY=tu_clave_api_de_brevo
BREVO_SENDER_EMAIL=tu_remitente_verificado
BREVO_SENDER_NAME=Beto UNEMI
PUBLIC_BASE_URL=http://localhost:3000
EMAIL_REMINDERS_FILE=beto_email_reminders.json
EMAIL_REMINDERS_DB_PATH=beto_email_reminders.sqlite3
