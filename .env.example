# Clave de Groq: necesaria para transcribir el audio de videos y como respaldo
# de Gemini para el chat, los resúmenes y las presentaciones.
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# Modelo de Groq usado cuando Gemini falla; no se usa para transcribir audio.
GROQ_MODEL=openai/gpt-oss-120b
# Puerto donde escucha el servidor Node.
PORT=3000

# Clave de Gemini: proveedor principal para chat, presentaciones y resúmenes.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Modelo Gemini que Beto intenta usar primero para generar texto.
GEMINI_MODEL=gemini-4-argon
# Unsplash busca fotografías para ilustrar las diapositivas; no genera texto.
UNSPLASH_ACCESS_KEY=YOUR_UNSPLASH_ACCESS_KEY_HERE

# ==========================================
# GOOGLE OAUTH 2.0 Y DRIVE (OFICIAL)
# ==========================================
# ID de cliente OAuth 2.0 de la consola de Google Cloud
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
# URI de redirección registrada en la consola de Google Cloud
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
